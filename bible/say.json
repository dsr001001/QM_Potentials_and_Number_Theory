[
 {
  "key": "t_n",
  "kind": "sym",
  "pat": "t_n",
  "show": "$t_n$",
  "say": "$t$ sub $n$, or simply $t$ $n$",
  "note": "A small letter or number set low after a symbol is a label, read ``sub''"
 },
 {
  "key": "ell",
  "kind": "sym",
  "pat": "\\\\ell",
  "show": "$\\ell$",
  "say": "ell",
  "note": "A script letter l, written this way so that it is not mistaken for the digit 1"
 },
 {
  "key": "Nsm",
  "kind": "sym",
  "pat": "\\\\Nsm",
  "show": "$\\Nsm$",
  "say": "$N$ smooth",
  "note": "Letter by letter it is ``$N$ sub s m''"
 },
 {
  "key": "prime",
  "kind": "sym",
  "pat": "[A-Za-z}]'\\(|[a-zA-Z]'\\$",
  "show": "$f'(x)$",
  "say": "$f$ prime of $x$",
  "note": "In British and Indian usage, ``$f$ dash of $x$''. The mark means the derivative of $f$"
 },
 {
  "key": "zeta",
  "kind": "sym",
  "pat": "\\\\zeta",
  "show": "$\\zeta$",
  "say": "zeta",
  "note": "A Greek letter: \\emph{ZAY-tuh} in American English, \\emph{ZEE-tuh} in British English. $\\zeta(s)$ is read ``zeta of $s$''",
  "also": [
   "16"
  ]
 },
 {
  "key": "rho",
  "kind": "sym",
  "pat": "\\\\rho",
  "show": "$\\rho$",
  "say": "rho",
  "note": "A Greek letter; it rhymes with ``go''"
 },
 {
  "key": "propto",
  "kind": "sym",
  "pat": "\\\\propto",
  "show": "$\\propto$",
  "say": "is proportional to"
 },
 {
  "key": "bar",
  "kind": "sym",
  "pat": "\\\\bar\\{? ?z",
  "show": "$\\bar z$",
  "say": "$z$ bar",
  "note": "The bar here means the complex conjugate. Later in the book a bar over a symbol is also used for an average"
 },
 {
  "key": "fact",
  "kind": "sym",
  "pat": "[a-zA-Z0-9)]!",
  "show": "$n!$",
  "say": "$n$ factorial"
 },
 {
  "key": "phi",
  "kind": "sym",
  "pat": "\\\\phi|\\\\varphi",
  "show": "$\\phi$",
  "say": "phi",
  "note": "A Greek letter, said \\emph{fie} (rhymes with ``pie'') or \\emph{fee}. It is written $\\phi$ or $\\varphi$; the capital is $\\Phi$"
 },
 {
  "key": "epsilon",
  "kind": "sym",
  "pat": "\\\\varepsilon|\\\\epsilon",
  "show": "$\\varepsilon$",
  "say": "epsilon",
  "note": "A Greek letter, \\emph{EP-sih-lon}; also written $\\epsilon$. It usually stands for a small quantity"
 },
 {
  "key": "prod",
  "kind": "sym",
  "pat": "\\\\prod",
  "show": "$\\prod$",
  "say": "product",
  "note": "A capital Greek pi. $\\prod_{k=1}^{\\infty}u_k$ is read ``the product, from $k$ equals one to infinity, of $u$ $k$''"
 },
 {
  "key": "hat",
  "kind": "sym",
  "pat": "\\\\hat",
  "show": "$\\hat x$",
  "say": "$x$ hat"
 },
 {
  "key": "O",
  "kind": "sym",
  "pat": "\\\\order\\(",
  "show": "$f=\\order(g)$",
  "say": "$f$ is big O of $g$",
  "note": "The letter is a capital O (``oh''), not a zero"
 },
 {
  "key": "o",
  "kind": "sym",
  "pat": "=o\\(",
  "show": "$f=o(g)$",
  "say": "$f$ is little o of $g$"
 },
 {
  "key": "sim",
  "kind": "sym",
  "pat": "\\\\sim(?![a-z])",
  "show": "$f\\sim g$",
  "say": "$f$ is asymptotic to $g$",
  "note": "The sign $\\sim$ on its own is called a tilde, or ``twiddle''. In looser use it means ``roughly'' or ``of the order of''",
  "from": "04"
 },
 {
  "key": "Gammaf",
  "kind": "sym",
  "pat": "\\\\Gamma\\(",
  "show": "$\\Gamma(z)$",
  "say": "gamma of $z$",
  "note": "$\\Gamma$ is the capital Greek gamma, \\emph{GAM-uh}"
 },
 {
  "key": "xi",
  "kind": "sym",
  "pat": "\\\\xi(?![a-z])",
  "show": "$\\xi$",
  "say": "xi",
  "note": "A Greek letter: most often \\emph{ksee} or \\emph{k-SIGH}; some say \\emph{zigh}"
 },
 {
  "key": "in",
  "kind": "sym",
  "pat": "\\\\in(?![a-z])",
  "show": "$x\\in I$",
  "say": "$x$ in $I$",
  "note": "Or ``$x$ belongs to $I$''"
 },
 {
  "key": "psi",
  "kind": "sym",
  "pat": "\\\\psi",
  "show": "$\\psi$",
  "say": "psi",
  "note": "A Greek letter, said \\emph{sigh} (the p is silent in English); some say \\emph{psee}. The capital is $\\Psi$"
 },
 {
  "key": "Psi",
  "kind": "sym",
  "pat": "\\\\Psi",
  "show": "$\\Psi$",
  "say": "capital psi",
  "note": "Psi is said \\emph{sigh}; the small letter is $\\psi$",
  "from": "10"
 },
 {
  "key": "Nfl",
  "kind": "sym",
  "pat": "\\\\Nfl",
  "show": "$\\Nfl$",
  "say": "$N$ fluctuating",
  "note": "Letter by letter it is ``$N$ sub f l''"
 },
 {
  "key": "tau",
  "kind": "sym",
  "pat": "\\\\tau",
  "show": "$\\tau$",
  "say": "tau",
  "note": "A Greek letter; it rhymes with ``cow'', though some say \\emph{taw}"
 },
 {
  "key": "ll",
  "kind": "sym",
  "pat": "\\\\ll(?![a-z])",
  "show": "$\\ll$",
  "say": "is much less than",
  "note": "Likewise $\\gg$ is ``is much greater than''"
 },
 {
  "key": "nu",
  "kind": "sym",
  "pat": "\\\\nu(?![a-z])",
  "show": "$\\nu$",
  "say": "nu",
  "note": "A Greek letter, said \\emph{new}. Take care not to read it as the Latin letter $v$"
 },
 {
  "key": "Rightarrow",
  "kind": "sym",
  "pat": "\\\\Rightarrow",
  "show": "$\\Rightarrow$",
  "say": "implies"
 },
 {
  "key": "sinc",
  "kind": "sym",
  "pat": "sinc",
  "show": "$\\mathrm{sinc}$",
  "say": "sink"
 },
 {
  "key": "gtrsim",
  "kind": "sym",
  "pat": "\\\\gtrsim|\\\\lesssim",
  "show": "$\\gtrsim$",
  "say": "is greater than or roughly equal to",
  "note": "Likewise $\\lesssim$ is ``is less than or roughly equal to''"
 },
 {
  "key": "floor",
  "kind": "sym",
  "pat": "\\\\lfloor",
  "show": "$\\lfloor x\\rfloor$",
  "say": "floor of $x$",
  "note": "The largest whole number that is not greater than $x$"
 },
 {
  "key": "tilde",
  "kind": "sym",
  "pat": "\\\\tilde",
  "show": "$\\tilde x$",
  "say": "$x$ tilde",
  "note": "\\emph{TIL-duh}. Some say ``$x$ twiddle''"
 },
 {
  "key": "Lambda",
  "kind": "sym",
  "pat": "\\\\Lambda",
  "show": "$\\Lambda$",
  "say": "capital lambda"
 },
 {
  "key": "norm",
  "kind": "sym",
  "pat": "\\\\norm",
  "show": "$\\norm{\\bm u}$",
  "say": "norm of $u$",
  "note": "Or ``the length of $u$''"
 },
 {
  "key": "braket",
  "kind": "sym",
  "pat": "\\\\braket",
  "show": "$\\braket{u}{v}$",
  "say": "bra $u$, ket $v$",
  "note": "Often just ``$u$, $v$''. The two halves of a bracket give the names bra and ket"
 },
 {
  "key": "inverse",
  "kind": "sym",
  "pat": "[A-Z]\\^\\{-1\\}",
  "show": "$A^{-1}$",
  "say": "$A$ inverse"
 },
 {
  "key": "hbar",
  "kind": "sym",
  "pat": "\\\\hbar",
  "show": "$\\hbar$",
  "say": "$h$ bar",
  "note": "Planck's constant $h$ divided by $2\\pi$"
 },
 {
  "key": "kappa",
  "kind": "sym",
  "pat": "\\\\kappa",
  "show": "$\\kappa$",
  "say": "kappa",
  "note": "A Greek letter, \\emph{KAP-uh}"
 },
 {
  "key": "partial",
  "kind": "sym",
  "pat": "\\\\partial",
  "show": "$\\partial$",
  "say": "partial",
  "note": "$\\partial S/\\partial c$ is read ``partial $S$ by partial $c$'', or ``dee $S$ by dee $c$''. The symbol itself is also called ``curly d'' or ``del''"
 },
 {
  "key": "varrho",
  "kind": "sym",
  "pat": "\\\\varrho",
  "show": "$\\varrho$",
  "say": "rho",
  "note": "Another way of writing the Greek letter $\\rho$, used here to keep the two apart"
 },
 {
  "key": "chi",
  "kind": "sym",
  "pat": "\\\\chi",
  "show": "$\\chi$",
  "say": "chi",
  "note": "A Greek letter, said \\emph{kye}; it rhymes with ``sky''"
 },
 {
  "key": "oint",
  "kind": "sym",
  "pat": "\\\\oint",
  "show": "$\\oint$",
